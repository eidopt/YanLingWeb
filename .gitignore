# Runtime mirror of mock/assets; canonical PNGs live under mock/assets/.
public/template-assets/pool/
public/template-assets/generated/

# Ephemeral template JSON outputs (`pnpm templates:generate` → backend import → delete)
/templates_json/*.json
templates_json/preview/public/templates-index.json
templates_json/*.validation.log

# Shared mock templates are committed; only validation logs are ignored
mock/*.validation.log

