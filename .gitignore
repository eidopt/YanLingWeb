# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# pnpm is the only supported package manager for this workspace.
package-lock.json

node_modules
.pnpm-store/
dist
dist-ssr
dist-electron
*.local
.claude/

# Next.js
.next
out
release
playwright-report
test-results
coverage/
backend/coverage/
*.tsbuildinfo

# Export output — compiled project builds land here
output/*
!output/.gitkeep

# Backend
backend/dist
backend/node_modules
backend/data/*.db
backend/data/*.db-*

# Shared — generated OpenAPI spec (regenerated on backend start)
shared/openapi.json

# Generated template image assets — regenerated per device via `pnpm assets:pregenerate`
# (kept out of git: large binaries; the manifest + scripts are committed instead)
public/template-assets/generated/
public/template-assets/pool/

# Generated template JSON outputs (produced by `pnpm templates:generate`, imported on backend start)
/templates_json/*.json
templates_json/preview/public/templates-index.json
templates_json/*.validation.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.git-xdg
.workbuddy/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

