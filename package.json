{
  "name": "ai-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "bcrypt",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "sharp"
    ]
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm shared:module-format:check && pnpm shared:boundary:check && pnpm renderer:registry:check && next build",
    "build:backend": "pnpm --dir backend build",
    "build:preview": "pnpm --dir templates_json/preview build",
    "build:all": "pnpm build && pnpm build:backend && pnpm build:preview",
    "start": "next start",
    "lint": "pnpm shared:module-format:check && pnpm shared:boundary:check && pnpm renderer:registry:check && eslint .",
    "lint:backend": "pnpm --dir backend lint",
    "lint:all": "pnpm lint && pnpm lint:backend",
    "format": "prettier --write --ignore-unknown .",
    "format:staged": "node scripts/fixStagedPrettier.cjs",
    "format:check": "prettier --check --ignore-unknown package.json pnpm-workspace.yaml prettier.config.mjs .prettierignore .githooks/pre-commit scripts/runLintStaged.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:backend": "tsc --noEmit --project backend/tsconfig.json --pretty false",
    "typecheck:preview": "tsc --noEmit --project templates_json/preview/tsconfig.json --pretty false",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:backend && pnpm typecheck:preview",
    "precommit": "node scripts/runLintStaged.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev:backend": "pnpm --dir backend dev",
    "dev:all": "concurrently --kill-others-on-fail \"next dev\" \"pnpm --dir backend dev\"",
    "dev:preview": "pnpm --dir templates_json/preview dev",
    "dev:electron": "concurrently --kill-others-on-fail \"next dev\" \"pnpm build:electron:main && wait-on http://localhost:3000 && electron dist-electron/main.cjs\"",
    "build:electron:main": "vite build --config vite.electron.config.ts",
    "build:electron:renderer": "next build",
    "build:electron": "pnpm build:electron:renderer && pnpm build:electron:main && electron-builder",
    "build:electron:dir": "pnpm build:electron:renderer && pnpm build:electron:main && electron-builder --dir",
    "test:integration": "node scripts/integrationTest.js",
    "test:coverage:backend": "pnpm --dir backend test:coverage",
    "test:e2e:backend": "pnpm --dir backend test:e2e",
    "test:e2e:browser": "node scripts/runBrowserE2e.cjs",
    "test:state-persistence": "tsx scripts/templatesPageStatePersistenceSmoke.ts",
    "test:di-container": "tsx scripts/diContainerSmoke.ts",
    "test:css-contract": "tsx scripts/cssVarsContractSmoke.ts",
    "test:source-export": "node scripts/sourceExportSmoke.cjs",
    "test:shared": "tsx --test shared/agent/contracts/editorUndoStack.spec.ts shared/agent/editor/atomicApply.spec.ts shared/agent/editor/existingNodeGate.spec.ts shared/agent/editor/nodeCandidateSet.spec.ts src/ui/editor/stream/sseOutputController.spec.ts shared/agent/template/buildTemplateProfile.spec.ts shared/agent/tools/semanticToolExecutor.spec.ts shared/agent/tools/semanticTools.spec.ts shared/agent/compiler/semanticInstructionCompiler.spec.ts src/ai/core/compact/autoCompact.spec.ts src/ai/core/compact/compactionDecision.spec.ts",
    "renderer:registry:check": "node scripts/checkRendererRegistry.cjs",
    "module-boundaries:audit": "node scripts/auditModuleBoundaries.cjs",
    "shared:module-format:check": "node scripts/checkSharedModuleFormat.cjs",
    "shared:boundary:check": "node scripts/checkSharedBoundaries.cjs",
    "renderer:registry:fix": "node scripts/checkRendererRegistry.cjs --fix && eslint src/ui/renderer/components/registry.tsx src/ui/renderer/components/index.ts --fix && prettier --write src/ui/renderer/components/registry.tsx src/ui/renderer/components/index.ts",
    "agent:evaluate": "node scripts/agent-eval/runAgentEval.js",
    "agent:live-smoke": "node scripts/agent-eval/runLiveSmoke.js",
    "agent:cache-test": "node scripts/agent-eval/runCacheHitrate.js",
    "agent:eval:envelope": "tsx scripts/agentEvalEnvelope.ts",
    "templates:validate": "node scripts/validateTemplateJson.mjs",
    "templates:generate": "pnpm --dir backend exec ts-node -r tsconfig-paths/register scripts/generate-templates-cli.ts",
    "assets:pregenerate": "pnpm --dir backend exec ts-node -r tsconfig-paths/register scripts/pregenerate-asset-library.ts",
    "assets:import-existing": "pnpm --dir backend exec ts-node -r tsconfig-paths/register scripts/import-existing-assets.ts"
  },
  "dependencies": {
    "next": "15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^15.5.18",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.8",
    "wait-on": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,md,css,scss,yml,yaml}": "prettier --check --ignore-unknown",
    "src/**/*.{js,jsx,ts,tsx}": "eslint --max-warnings=0",
    "electron/**/*.{js,ts}": "eslint --max-warnings=0",
    "backend/src/**/*.ts": "pnpm --dir backend exec eslint --max-warnings=0",
    "templates_json/preview/src/**/*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "build": {
    "appId": "com.ai-app.desktop",
    "productName": "AI App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
