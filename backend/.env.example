PORT=4000
SERVER_FLAVOR=development
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,app://
DATABASE_DRIVER=sqlite
DEFAULT_DB_PATH=/custom/path/to/app.db
DB_SYNCHRONIZE=true
# Pending public template JSON import on backend startup.
# The backend scans templates_json by default, imports valid JSON files,
# flushes the DB, then deletes imported JSON files so they are not re-read.
# TEMPLATE_JSON_IMPORT_ENABLED=true
# TEMPLATE_JSON_IMPORT_DIR=../templates_json
# TEMPLATE_JSON_DELETE_AFTER_IMPORT=true
# Required in production. Use a stable random value; changing it invalidates existing JWTs.
# Example: openssl rand -hex 32
JWT_SECRET=replace-with-a-stable-random-secret
JWT_EXPIRES_IN=7d

# AI provider: 'openai' (Responses API) or 'openai-compatible' (Chat Completions API)
# AI_PROVIDER=openai

# Pro model used for normal agent generation/editing.
# AI_MODEL remains supported as a backwards-compatible alias for AI_PRO_MODEL.
# Default: gpt-5.4 when AI_PROVIDER=openai, deepseek-chat when AI_PROVIDER=openai-compatible
# AI_PRO_MODEL=deepseek-chat
# AI_MODEL=deepseek-chat

# Optional lite model used for low-risk background tasks such as LLM compaction.
# When omitted, the backend falls back to the pro model for all tasks.
# AI_LITE_MODEL=deepseek-v4-flash

# Optional image generation model used only by the template visualAssets pipeline.
# When omitted or unsupported by the selected provider, visual assets fall back to placeholders.
# AI_IMAGE_MODEL=gpt-image-1.5

# When AI_PROVIDER=openai → reads OPENAI_API_KEY / OPENAI_BASE_URL
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# When AI_PROVIDER=openai-compatible → reads DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Generic fallbacks (used when provider-specific vars are not set)
# AI_API_KEY=
# AI_BASE_URL=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=

# Environment-specific overrides take precedence over the generic names above.
# This file is documentation only. Runtime env files are .env.dev, .env.prod,
# .env.test, or their .local variants.
# Startup flag examples: --flavor=dev, --flavor=prod, --env=test.
# Canonical env files: .env.dev, .env.prod, .env.test.
# DEV_DEFAULT_DB_PATH=
# PROD_DEFAULT_DB_PATH=
# DB_PATH=/custom/path/to/override.db
# DEV_WECHAT_REDIRECT_URI=
# PROD_WECHAT_REDIRECT_URI=
