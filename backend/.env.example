PORT=4000
SERVER_FLAVOR=development
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,app://
DEFAULT_DB_PATH=/custom/path/to/app.db
JWT_SECRET=
JWT_EXPIRES_IN=7d

AI_API_KEY=
# Optional. Leave empty for the SDK default, or set an OpenAI-compatible gateway URL.
# AI_BASE_URL=https://api.openai.com/v1

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=

