{
  "name": "ai-app-backend",
  "version": "1.0.0",
  "description": "NestJS backend for AI App",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/backend/src/main",
    "start:dev": "nest start --watch --entryFile backend/src/main -- --flavor=dev",
    "start:debug": "nest start --debug --watch --entryFile backend/src/main -- --flavor=dev",
    "start:prod": "node dist/backend/src/main --flavor=prod",
    "db:init": "node scripts/init-db.js",
    "db:init:dev": "node scripts/init-db.js --flavor=dev",
    "db:init:prod": "node scripts/init-db.js --flavor=prod",
    "db:init:test": "node scripts/init-db.js --flavor=test",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:generate:dev": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts -- --flavor=dev",
    "migration:generate:prod": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts -- --flavor=prod",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:run:dev": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts -- --flavor=dev",
    "migration:run:prod": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts -- --flavor=prod",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:revert:dev": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts -- --flavor=dev",
    "migration:revert:prod": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts -- --flavor=prod",
    "dev": "npm run db:init:dev && nest start --watch --entryFile backend/src/main -- --flavor=dev",
    "lint": "eslint src --fix",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "openai": "^6.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
