SERVER_FLAVOR=development
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,app://
DATABASE_DRIVER=sqlite
DEFAULT_DB_PATH=./data/app.dev.db
DB_SYNCHRONIZE=true
TEMPLATE_JSON_IMPORT_ENABLED=true
TEMPLATE_JSON_DELETE_AFTER_IMPORT=true
JWT_SECRET=development-jwt-secret
JWT_EXPIRES_IN=7d

# Keep real secrets in backend/.env.dev.local or your shell.
AI_PROVIDER=openai-compatible
AI_PRO_MODEL=deepseek-flash
# Optional lite model for background/compaction tasks. Falls back to pro if empty.
AI_LITE_MODEL=deepseek-flash

# Optional image generation config (independent of the main chat provider; e.g. still shared
# when AI_PROVIDER=openai-compatible / DeepSeek). Key falls back to OPENAI_API_KEY / AI_API_KEY;
# AI_IMAGE_GENERATION can also hold either "off" (disable) or an image API key directly.
# When true, creating/saving templates calls the real image generation API; false uses placeholders.
AI_MATERIALIZE_IMAGES=false
# Optional public URL prefix for generated images (defaults to /template-assets/...).
# AI_IMAGE_PUBLIC_BASE_URL=
# AI_IMAGE_MODEL=gpt-image-1.5
# AI_IMAGE_BASE_URL accepts either a base prefix (https://.../v1) or a full endpoint URL.
# AI_IMAGE_BASE_URL=https://api.openai.com/v1
# AI_IMAGE_PROVIDER=
# AI_IMAGE_API_KEY=
# AI_IMAGE_GENERATION=
# AI_IMAGE_TIMEOUT_MS=300000
# AI_IMAGE_MAX_RETRIES=0

# Provider-specific API keys and base URLs.
# The config reads {PROVIDER}_API_KEY / {PROVIDER}_BASE_URL based on AI_PROVIDER:
#   AI_PROVIDER=openai             -> OPENAI_API_KEY, OPENAI_BASE_URL
#   AI_PROVIDER=openai-compatible  -> DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL
# Generic AI_API_KEY / AI_BASE_URL are fallbacks when the provider-specific
# vars are not set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OAuth callback settings for local development.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_REDIRECT_URI=
