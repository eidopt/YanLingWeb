SERVER_FLAVOR=development
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,app://
DEFAULT_DB_PATH=./data/app.dev.db
JWT_EXPIRES_IN=7d

# Keep secrets in backend/.env.dev.local or your shell.
AI_PROVIDER=openai-compatible
AI_MODEL=deepseek-v4-pro

# Model name sent to the provider (e.g. gpt-5.4, deepseek-chat, deepseek-v3).
# Default: gpt-5.4 for openai provider, deepseek-chat for openai-compatible.
# AI_MODEL=deepseek-chat-compatible

# Provider-specific API keys and base URLs.
# The config reads {PROVIDER}_API_KEY / {PROVIDER}_BASE_URL based on AI_PROVIDER:
#   AI_PROVIDER=openai             → OPENAI_API_KEY, OPENAI_BASE_URL
#   AI_PROVIDER=openai-compatible  → DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL
# Generic AI_API_KEY / AI_BASE_URL are fallbacks when the provider-specific
# vars are not set.
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=sk-c32b5f1183a8407ebba2a778df206c9b
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
