PORT=4000
NODE_ENV=development

# Override DB path if needed (default: ~/Documents/ai-app-data/app.db)
DATABASE_DRIVER=sqljs
# DB_PATH=/path/to/custom/app.db
DB_SYNCHRONIZE=true

# AI provider: 'openai' (Responses API) or 'openai-compatible' (Chat Completions API).
# 'openai-compatible' works with DeepSeek, Azure OpenAI, Groq, etc.
AI_PROVIDER=openai-compatible
AI_MODEL=deepseek-v4-pro

# Model name sent to the provider (e.g. gpt-5.4, deepseek-chat, deepseek-v3).
# Default: gpt-5.4 for openai provider, deepseek-chat for openai-compatible.
# AI_MODEL=deepseek-chat-compatible

# Provider-specific API keys and base URLs.
# The config reads {PROVIDER}_API_KEY / {PROVIDER}_BASE_URL based on AI_PROVIDER:
#   AI_PROVIDER=openai             → OPENAI_API_KEY, OPENAI_BASE_URL
#   AI_PROVIDER=openai-compatible  → DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL
# Generic AI_API_KEY / AI_BASE_URL are fallbacks when the provider-specific
# vars are not set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WeChat Open Platform — https://open.weixin.qq.com/
# WECHAT_APP_ID=wx_your_app_id
# WECHAT_APP_SECRET=your_wechat_secret
# WECHAT_REDIRECT_URI=http://localhost:3000/auth/callback/wechat

# QQ Connect — https://connect.qq.com/
# QQ_APP_ID=your_qq_app_id
# QQ_APP_SECRET=your_qq_secret
# QQ_REDIRECT_URI=http://localhost:3000/auth/callback/qq
