      "28rpx",
      "32rpx",
      "36rpx",
      "40rpx",
      "64rpx"
    ],
    "fontWeights": [
      "normal",
      "bold"
    ],
    "spacing": [
      "8rpx",
      "12rpx",
      "16rpx",
      "20rpx",
      "24rpx",
      "32rpx"
    ],
    "radius": [
      "8rpx",
      "12rpx",
      "16rpx",
      "50%"
    ],
    "shadows": [
      "0 4rpx 16rpx rgba(0,0,0,0.08)"
    ],
    "componentDensity": "compact",
    "commonLayoutPatterns": [
      "tool-grid",
      "calculator-layout",
      "settings-list"
    ]
  }
}
