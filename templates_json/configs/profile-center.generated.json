{
  "templateId": "profile-center",
  "templateVersion": "1.0.0",
  "profileVersion": "1.0.0",
  "devices": [
    "miniapp"
  ],
  "pages": [
    {
      "pageKey": "profile.home",
      "pageId": "page-home",
      "pageKind": "profile",
      "name": "个人中心",
      "description": "展示用户头像、昵称、统计数据、订单入口和功能菜单",
      "rootNodeId": "page-home-screen",
      "device": "miniapp",
      "isDefault": true
    },
    {
      "pageKey": "profile.orders",
      "pageId": "page-orders",
      "pageKind": "list",
      "name": "订单列表",
      "description": "展示用户的订单列表，支持按状态筛选",
      "rootNodeId": "page-orders-screen",
      "device": "miniapp"
    },
    {
      "pageKey": "profile.favorites",
      "pageId": "page-favorites",
      "pageKind": "grid",
      "name": "我的收藏",
      "description": "展示用户收藏的商品列表",
      "rootNodeId": "page-favorites-screen",
      "device": "miniapp"
    },
    {
      "pageKey": "profile.settings",
      "pageId": "page-settings",
      "pageKind": "settings",
      "name": "设置",
      "description": "账户设置、通知偏好、关于我们等",
      "rootNodeId": "page-settings-screen",
      "device": "miniapp"
    }
  ],
  "regions": [
    {
      "regionKey": "profile.header",
      "pageKey": "profile.home",
      "nodeId": "user-header",
      "name": "用户信息头部",
      "sectionKind": "header",
      "replaceable": false
    },
    {
      "regionKey": "profile.stats",
      "pageKey": "profile.home",
      "nodeId": "stats-row",
      "name": "统计数据",
      "sectionKind": "stats",
      "replaceable": false
    },
    {
      "regionKey": "profile.orderEntry",
      "pageKey": "profile.home",
      "nodeId": "order-section",
      "name": "订单入口",
      "sectionKind": "quick_actions",
      "replaceable": true,
      "allowedPatternKeys": [
        "profile.orderActions"
      ]
    },
    {
      "regionKey": "profile.menu",
      "pageKey": "profile.home",
      "nodeId": "menu-list",
      "name": "功能菜单",
      "sectionKind": "menu",
      "replaceable": true,
      "allowedPatternKeys": [
        "profile.menuItems"
      ]
    },
    {
      "regionKey": "profile.orders.list",
      "pageKey": "profile.orders",
      "nodeId": "order-list",
      "name": "订单列表",
      "sectionKind": "list",
      "replaceable": true,
      "allowedPatternKeys": [
        "profile.orderCards"
      ]
    },
    {
      "regionKey": "profile.favorites.grid",
      "pageKey": "profile.favorites",
      "nodeId": "fav-grid",
      "name": "收藏网格",
      "sectionKind": "grid",
      "replaceable": true,
      "allowedPatternKeys": [
        "profile.favoriteItems"
      ]
    }
  ],
  "slots": [
    {
      "slotKey": "profile.header.avatar",
      "pageKey": "profile.home",
      "regionKey": "profile.header",
      "nodeId": "avatar",
      "component": "core.image",
      "editableProps": [
        "src"
      ],
      "aiRole": "avatar",
      "label": "用户头像"
    },
    {
      "slotKey": "profile.header.name",
      "pageKey": "profile.home",
      "regionKey": "profile.header",
      "nodeId": "username",
      "component": "core.text",
      "editableProps": [
        "text"
      ],
      "aiRole": "username",
      "label": "用户昵称"
    },
    {
      "slotKey": "profile.header.userId",
      "pageKey": "profile.home",
      "regionKey": "profile.header",
      "nodeId": "user-id",
      "component": "core.text",
      "editableProps": [
        "text"
      ],
      "aiRole": "userId",
      "label": "用户ID"
    },
    {
      "slotKey": "profile.stats.favorites",
      "pageKey": "profile.home",
      "regionKey": "profile.stats",
      "nodeId": "fav-num",
      "component": "core.text",
      "editableProps": [
        "text"
      ],
      "aiRole": "count",
      "label": "收藏数"
    },
    {
      "slotKey": "profile.stats.following",
      "pageKey": "profile.home",
      "regionKey": "profile.stats",
      "nodeId": "follow-num",
      "component": "core.text",
      "editableProps": [
        "text"
      ],
      "aiRole": "count",
      "label": "关注数"
    },
    {
      "slotKey": "profile.stats.fans",
      "pageKey": "profile.home",
      "regionKey": "profile.stats",
      "nodeId": "fans-num",
      "component": "core.text",
      "editableProps": [
        "text"
      ],
      "aiRole": "count",
      "label": "粉丝数"
    }
  ],
  "patterns": [
    {
      "patternKey": "profile.orderActions",
      "pageKey": "profile.home",
      "regionKey": "profile.orderEntry",
      "sourceRootNodeId": "order-grid",
      "parentNodeId": "order-grid",
      "itemAlias": "orderAction",
      "fields": [
        {
          "fieldKey": "icon",
          "slotKey": "profile.orderAction.icon",
          "prop": "name",
          "required": true
        },
        {
          "fieldKey": "label",
          "slotKey": "profile.orderAction.label",
          "prop": "text",
          "required": true
        }
      ],
      "maxItems": 6,
      "minItems": 2
    },
    {
      "patternKey": "profile.menuItems",
      "pageKey": "profile.home",
      "regionKey": "profile.menu",
      "sourceRootNodeId": "menu-fav",
      "parentNodeId": "menu-list",
      "itemAlias": "menuItem",
      "fields": [
        {
          "fieldKey": "icon",
          "slotKey": "profile.menuItem.icon",
          "prop": "name",
          "required": true
        },
        {
          "fieldKey": "label",
          "slotKey": "profile.menuItem.label",
          "prop": "text",
          "required": true
        }
      ],
      "maxItems": 10,
      "minItems": 1
    }
  ],
  "navigation": {
    "type": "none",
    "items": []
  },
  "constraints": {
    "devices": [
      "miniapp"
    ],
    "maxColumns": 4,
    "allowedLayouts": [
      "core.stack",
      "core.row",
      "core.grid"
    ],
    "requiredComponents": [
      "core.text",
      "core.image"
    ]
  },
  "styleProfile": {
    "colors": [
      "#6366f1",
      "#4f46e5",
      "#818cf8",
      "#1e293b",
      "#64748b",
      "#e2e8f0",
      "#f8fafc",
      "#ffffff"
    ],
    "fontSizes": [
      "22rpx",
      "24rpx",
      "26rpx",
      "28rpx",
      "30rpx",
      "32rpx",
      "36rpx"
    ],
    "fontWeights": [
      "normal",
      "bold"
    ],
    "spacing": [
      "8rpx",
      "12rpx",
      "16rpx",
      "20rpx",
      "24rpx",
      "32rpx"
    ],
    "radius": [
      "8rpx",
      "12rpx",
      "16rpx",
      "32rpx",
      "50%"
    ],
    "shadows": [
      "0 2rpx 12rpx rgba(0,0,0,0.05)"
    ],
    "componentDensity": "comfortable",
    "commonLayoutPatterns": [
      "header-stats-menu",
      "card-grid",
      "list-with-arrow"
    ]
  }
}
