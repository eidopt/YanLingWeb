        },
        {
          "fieldKey": "image",
          "slotKey": "event.product.image",
          "prop": "src",
          "required": true
        },
        {
          "fieldKey": "price",
          "slotKey": "event.product.price",
          "prop": "text",
          "required": true
        },
        {
          "fieldKey": "originalPrice",
          "slotKey": "event.product.originalPrice",
          "prop": "text",
          "required": false
        }
      ],
      "maxItems": 20,
      "minItems": 1
