{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "src/*": ["../../src/*"],
      "base/*": ["../../src/base/*"],
      "hooks/*": ["../../src/hooks/*"],
      "lib/*": ["../../src/lib/*"],
      "services/*": ["../../src/services/*"],
      "types/*": ["../../src/types/*"],
      "ui/*": ["../../src/ui/*"],
      "views/*": ["../../src/views/*"]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}
